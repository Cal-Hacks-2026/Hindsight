# Copy to .env at the repo root and fill in. Never commit .env.
# Secrets are shared via DM (TASKS.md › Git rules).

# --- API (apps/api) ---
# Comma-separated origins allowed by CORS.
WEB_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Limits on endpoints that call Claude (429 when exceeded).
CLAUDE_PER_IP_PER_MIN=10
CLAUDE_DAILY_CAP=500
# Proxies in front of the API that append to X-Forwarded-For (Railway/Render: 1). 0 = use the socket peer.
TRUSTED_PROXY_HOPS=0

APIFY_TOKEN=
# Campus Radar webhook: Apify sends this secret in X-Hindsight-Webhook-Secret; unset = webhook disabled.
APIFY_WEBHOOK_SECRET=
# Public base URL of this API, used as the webhook target by `python -m app.scan --via-webhook`.
PUBLIC_API_URL=

# --- Droid agent (apps/agent; README › "How Droid is used") ---
FACTORY_API_KEY=
# Shared secret between the API and the agent (X-Agent-Secret). Unset = agent disabled.
AGENT_SECRET=
# Where the API reaches the agent, and the agent reaches the API (same container in production).
AGENT_URL=http://127.0.0.1:8787
AGENT_API_URL=http://127.0.0.1:8000
# Scheduled runs: every N minutes for each campus; 0 = only manual / new-profile runs.
AGENT_INTERVAL_MINUTES=120
# Which feeds to scan on the schedule; default: every opportunities.feed in data/campuses/*.json.
# AGENT_CAMPUSES=
# "Run now" clicks for a campus within this many minutes of the last manual run reuse it.
AGENT_MANUAL_COOLDOWN_MINUTES=2
# Droid sessions for new profiles per rolling hour (POST /profiles is public); past this,
# profile runs rank and alert directly without Droid.
AGENT_PROFILE_RUNS_PER_HOUR=6
# Optional: Droid model id (default: Droid's own default), per-run patch budget, run timeout.
DROID_MODEL=
AGENT_MAX_PATCHES=4
AGENT_RUN_TIMEOUT_MINUTES=20

# --- Web (apps/web) — VITE_* values are bundled into the browser; no secrets. ---
VITE_API_URL=http://localhost:8000
